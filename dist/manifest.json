{
  "manifest_version": 3,
  "name": "Gemini Developer Assistant",
  "version": "1.0",
  "description": "Custom extension for token counting and text generation using Gemini 2.0 API.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}